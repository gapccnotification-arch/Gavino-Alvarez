services:
  - type: web
    name: gapcc
    runtime: python
    plan: starter
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    disk:
      name: gapcc-data
      mountPath: /var/data
      sizeGB: 1
    envVars:
      - key: GAPCC_DATABASE_PATH
        value: /var/data/gapcc.db
      - key: GAPCC_SMTP_HOST
        sync: false
      - key: GAPCC_SMTP_PORT
        sync: false
      - key: GAPCC_SMTP_USER
        sync: false
      - key: GAPCC_SMTP_PASSWORD
        sync: false
      - key: GAPCC_SMTP_FROM
        sync: false
